{
  "name": "noor-academy-api",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "setup": "node scripts/setup.js",
    "data:sync": "node scripts/sync-data.js",
    "admin:create": "node --env-file=.env scripts/create-admin.js",
    "test": "node --test tests/core.test.js tests/library.test.js tests/rate-limit-store.test.js tests/timetable.test.js tests/otp-core.test.js tests/profile-core.test.js",
    "test:integration": "node --env-file=.env.testing --test tests/integration.test.js",
    "messages:encrypt": "node --env-file=.env scripts/encrypt-messages.js",
    "setup:test": "node scripts/setup-test.js",
    "dev:test": "node --env-file=.env.testing src/server.js",
    "update:check": "node scripts/clean-legacy.mjs",
    "update:clean": "node scripts/clean-legacy.mjs --apply",
    "build": "node scripts/sync-data.js",
    "email:check": "node --env-file=.env scripts/check-email.js",
    "schedule:audit": "node --env-file=.env scripts/audit-schedules.js",
    "test:unit": "node --test tests/core.test.js tests/library.test.js tests/rate-limit-store.test.js tests/timetable.test.js tests/otp-core.test.js tests/profile-core.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.1.3",
    "nodemailer": "^7.0.12",
    "socket.io": "^4.8.3",
    "@socket.io/mongo-adapter": "^0.4.0"
  }
}
